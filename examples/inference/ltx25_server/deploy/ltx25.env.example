# Per-instance environment for ltx25@.service.
# Copy to /etc/ltx25/<gpu-id>.env — one per GPU. The GPU itself comes from
# the systemd instance name (ltx25@0 -> --gpu 0), so only PORT and LOG_DIR
# live here. Give each instance a DISTINCT log dir: the request log's
# RotatingFileHandler is not safe for two processes sharing one file.
#
#   /etc/ltx25/0.env :  PORT=8080  LOG_DIR=/workspace/ltx25/logs/gpu0
#   /etc/ltx25/1.env :  PORT=8081  LOG_DIR=/workspace/ltx25/logs/gpu1
PORT=8080
LOG_DIR=/workspace/ltx25/logs/gpu0
