# Per-instance environment for ltx23@.service.
# Copy to /etc/ltx23/<gpu-id>.env — one per GPU. The GPU itself comes from
# the systemd instance name (ltx23@0 -> --gpu 0), so only PORT and LOG_DIR
# live here. Give each instance a DISTINCT log dir: the request log's
# RotatingFileHandler is not safe for two processes sharing one file.
#
#   /etc/ltx23/0.env :  PORT=8080  LOG_DIR=/workspace/ltx23/logs/gpu0
#   /etc/ltx23/1.env :  PORT=8081  LOG_DIR=/workspace/ltx23/logs/gpu1
PORT=8080
LOG_DIR=/workspace/ltx23/logs/gpu0
